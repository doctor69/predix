# ─────────────────────────────────────────────
# Predix Frontend — Environment Variables
# Copy to .env.local and fill in the values
# ─────────────────────────────────────────────

# Privy App ID — get from https://privy.io (free up to 500 MAU)
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Deployed PredictionMarket contract address
# Leave empty to show "not deployed" state in UI
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Chain ID: 137 = Polygon mainnet, 80002 = Polygon Amoy testnet
NEXT_PUBLIC_CHAIN_ID=80002

# Optional: custom RPC URLs (leave blank to use public RPCs)
NEXT_PUBLIC_POLYGON_RPC=
NEXT_PUBLIC_AMOY_RPC=
