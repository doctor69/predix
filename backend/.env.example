# Database — PostgreSQL (Railway provides this automatically)
DATABASE_URL="postgresql://user:password@localhost:5432/predix"

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Privy — get App ID from https://console.privy.io
PRIVY_APP_ID=your-privy-app-id

# Admin wallet addresses (comma-separated, lowercase)
# These wallets can create/resolve markets via the API
ADMIN_ADDRESSES=0xYourAdminWalletAddress,0xAnotherAdmin
