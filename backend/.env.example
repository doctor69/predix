# Neon PostgreSQL — get from https://console.neon.tech
# Format: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/predix?sslmode=require

# Privy — get App ID from https://console.privy.io
PRIVY_APP_ID=your-privy-app-id

# Admin wallet addresses (comma-separated, lowercase)
ADMIN_ADDRESSES=0xYourAdminWallet,0xAnotherAdmin

# Cloudflare (set in wrangler.toml [vars] for non-secrets)
FRONTEND_URL=http://localhost:3000
