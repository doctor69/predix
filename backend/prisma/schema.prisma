// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  icon        String   @default("📊")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  markets Market[]

  @@map("categories")
}

model Market {
  id               String       @id // on-chain marketId (uint256 as string)
  question         String
  categoryId       String
  imageUrl         String?
  resolutionSource String
  closingTime      DateTime
  resolutionTime   DateTime
  status           MarketStatus @default(OPEN)
  resolution       Resolution?
  yesPool          String       @default("0") // stored as string to avoid BigInt overflow
  noPool           String       @default("0")
  totalVolume      String       @default("0")
  createdBy        String       // admin wallet address
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  resolvedAt       DateTime?
  txHash           String?      // creation tx hash
  resolveTxHash    String?      // resolution tx hash

  category  Category            @relation(fields: [categoryId], references: [id])
  evidence  ResolutionEvidence[]

  @@map("markets")
}

model User {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  displayName   String?
  avatarUrl     String?
  isAdmin       Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("users")
}

model ResolutionEvidence {
  id            String     @id @default(cuid())
  marketId      String
  adminAddress  String
  outcome       Resolution
  evidenceUrl   String?
  notes         String?
  createdAt     DateTime   @default(now())

  market Market @relation(fields: [marketId], references: [id])

  @@map("resolution_evidence")
}

enum MarketStatus {
  OPEN
  CLOSED
  RESOLVED
  CANCELLED
  DISPUTED
}

enum Resolution {
  YES
  NO
}
