{
  "name": "predix-contracts",
  "version": "1.0.0",
  "description": "Predix — zero-custody binary prediction market on Polygon (USDC)",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
