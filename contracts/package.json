    "node": "hardhat node",
    "clean": "hardhat clean"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "dotenv": "^16.0.0",
    "hardhat": "^2.22.0",
    "js-yaml": "^4.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
