# ── Wallet / Signer ──────────────────────────────────────────────────────────
# Private key of the deployer wallet (needs MATIC for gas). Never commit .env.
PRIVATE_KEY=0x...

# ── RPC Endpoints ────────────────────────────────────────────────────────────
AMOY_RPC=https://rpc-amoy.polygon.technology
POLYGON_RPC=https://polygon-rpc.com

# ── Polygonscan Verification ─────────────────────────────────────────────────
POLYGONSCAN_API_KEY=...

# ── Constructor Arguments ────────────────────────────────────────────────────
# ADMIN: Hot wallet that creates and resolves markets.
ADMIN_ADDRESS=0x6F9407c02813465Ea30dE311EE228340dCF8e050

# FEE_WALLET: Receives platform fees. Use a dedicated wallet.
FEE_WALLET=0xECF21A6B44B4bCe87c1BcOf039D475362c54d3O6

# USDC contract addresses (do not change unless using a fork)
USDC_ADDRESS_AMOY=0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
USDC_ADDRESS_POLYGON=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# Fee in basis points (200 = 2%, max allowed is 500 = 5%)
FEE_PERCENT=200
