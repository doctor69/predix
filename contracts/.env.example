# ─────────────────────────────────────────────────────────────
# PredictionMarket Contract - Environment Variables
# ─────────────────────────────────────────────────────────────
# NEVER commit your actual .env file to GitHub.
# This file (.env.example) is safe to commit.
# Copy this to .env and fill in real values.
# ─────────────────────────────────────────────────────────────

# Private key of wallet used ONLY to deploy (can be any wallet with MATIC for gas)
# After deployment, this wallet has no special power — it's just the deployer
DEPLOYER_PRIVATE_KEY=your_deployer_private_key_here

# ─── ROLE WALLETS ─────────────────────────────────────────────
# All four must be DIFFERENT addresses. No sharing.

# OWNER: Use a Gnosis Safe multisig in production.
# This is the highest-privilege role. Treat it like a bank vault.
# https://safe.global — create a multisig with 2-of-3 signers
OWNER_ADDRESS=0x_your_gnosis_safe_multisig_address

# ADMIN: Hot wallet. Used daily to create and resolve markets.
# If compromised, attacker can resolve markets wrong but CANNOT steal funds.
# Recommended: MetaMask wallet you use regularly
ADMIN_ADDRESS=0x_your_admin_hot_wallet_address

# FEE WALLET: Receives the 2% platform fee.
# Can be a regular MetaMask wallet. If compromised, attacker gets future fees only.
FEE_WALLET_ADDRESS=0x_your_fee_collection_wallet_address

# EMERGENCY ROLE: Can pause the contract instantly if exploit is detected.
# Can be same as owner for v1, or given to a trusted security partner.
EMERGENCY_ROLE_ADDRESS=0x_your_emergency_role_address

# ─── RPC URLS ─────────────────────────────────────────────────
# Free tier from Alchemy or Infura — sign up at alchemy.com
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
POLYGON_MAINNET_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# ─── POLYGONSCAN API KEY ───────────────────────────────────────
# Free at polygonscan.com/apis — used to verify contract source code
# Verified contracts show source code publicly (builds user trust)
POLYGONSCAN_API_KEY=your_polygonscan_api_key
